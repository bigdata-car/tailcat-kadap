#!/usr/bin/env bash
# Configure a persistent Tailcat server through SSH, then create a client-side
# launcher for a local TCP forward. Run this script on the client Ubuntu PC.
# Allow `sh setup_tailcat_client.sh` as well as direct/Bash execution. The
# remainder intentionally uses Bash features such as `[[` and `pipefail`.
if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

set -euo pipefail
umask 077

readonly TAILCAT_REPOSITORY="tailscale/tailcat"
readonly CLIENT_CONFIG_DIR="$HOME/.config/tailcat-connections"
readonly CLIENT_BIN_DIR="$HOME/.local/bin"
readonly CLIENT_TAILCAT_BIN="$CLIENT_BIN_DIR/tailcat-bin"
readonly CLIENT_STATE_DIR="$HOME/.local/state/tailcat-connections"
readonly SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( "$1" >= 1 && "$1" <= 65535 ))
}

usage() {
  cat <<'USAGE'
Usage:
  tailcat setup                  Configure a new Tailcat connection.
  tailcat start [connection]     Start a saved local TCP forward in background.
  tailcat stop [connection]      Stop that background forward.
  tailcat status [connection]    Show its local forwarding state.
  tailcat list [connection]      List saved local-to-remote port mappings.
  tailcat add <remote> <local>   Add and serve a remote port, then map it locally.
  tailcat del <local>            Remove a saved local-to-remote port mapping.
  tailcat reset [connection]     Remove one saved connection and its server service.
  tailcat tunnel [remote-port]   Publish a server port through a Cloudflare Quick Tunnel.
  tailcat install                 Install this executable into ~/.local/bin.
  tailcat uninstall               Remove ~/.local/bin/tailcat.

If no connection is supplied, the only saved connection is selected.
`add`, `del`, and `reset` ask for the server SSH/sudo password when needed.
`tunnel` installs cloudflared on the server only when tunnel is requested.
USAGE
}

load_connection() {
  local connection="${1:-}" configs=()
  if [[ -z "$connection" ]]; then
    shopt -s nullglob
    configs=("$CLIENT_CONFIG_DIR"/*.env)
    shopt -u nullglob
    if (( ${#configs[@]} != 1 )); then
      die "Specify a connection name. Available files: $CLIENT_CONFIG_DIR/*.env"
    fi
    connection="$(basename "${configs[0]}" .env)"
  fi
  [[ "$connection" =~ ^[A-Za-z0-9-]+$ ]] || die "Invalid connection name: $connection"
  config_file="$CLIENT_CONFIG_DIR/$connection.env"
  [[ -r "$config_file" ]] || die "Saved connection not found: $config_file"
  # This file is generated by this script with mode 0600.
  source "$config_file"
  [[ "$TAILCAT_BIN" == "$CLIENT_BIN_DIR/tailcat" ]] && TAILCAT_BIN="$CLIENT_TAILCAT_BIN"
  [[ -x "$TAILCAT_BIN" ]] || die "Tailcat binary not found: $TAILCAT_BIN"
  valid_port "$SERVER_PORT" || die "Invalid saved server port."
  valid_port "$CLIENT_PORT" || die "Invalid saved client port."
  SERVER_HOST="${SERVER_HOST:-$connection}"
  SERVER_USER="${SERVER_USER:-$(id -un)}"
  SERVER_SSH_PORT="${SERVER_SSH_PORT:-22}"
  PORT_MAPPINGS="${PORT_MAPPINGS:-$CLIENT_PORT:$SERVER_PORT}"
  TUNNEL_PORT="${TUNNEL_PORT:-}"
  TUNNEL_URL="${TUNNEL_URL:-}"
  IFS=',' read -r -a port_mappings <<< "$PORT_MAPPINGS"
  (( ${#port_mappings[@]} > 0 )) || die "No saved port mappings."
  local mapping local_port remote_port
  for mapping in "${port_mappings[@]}"; do
    IFS=: read -r local_port remote_port <<< "$mapping"
    valid_port "$local_port" && valid_port "$remote_port" || die "Invalid saved mapping: $mapping"
  done
  connection_name="$connection"
  pid_file="$CLIENT_STATE_DIR/$connection_name.pid"
  log_file="$CLIENT_STATE_DIR/$connection_name.log"
}

running_pid() {
  [[ -r "$pid_file" ]] || return 1
  local pid command
  pid="$(<"$pid_file")"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
  command="$(ps -p "$pid" -o comm= 2>/dev/null | xargs)"
  [[ "$command" == "tailcat" || "$command" == "tailcat-bin" ]]
}

start_connection() {
  install -d -m 700 "$CLIENT_STATE_DIR"
  if running_pid; then
    echo "Tailcat forward '$connection_name' is already running (PID $(<"$pid_file"))."
    return
  fi
  rm -f "$pid_file"
  nohup "$TAILCAT_BIN" forward "$TAILCAT_ADDRESS" "${port_mappings[@]}" \
    >>"$log_file" 2>&1 < /dev/null &
  printf '%s\n' "$!" > "$pid_file"
  for _ in $(seq 1 10); do
    if ss -ltn "sport = :${port_mappings[0]%%:*}" 2>/dev/null | grep -q ":${port_mappings[0]%%:*}"; then
      echo "Tailcat forward '$connection_name' started."
      return
    fi
    if ! running_pid; then break; fi
    sleep 1
  done
  printf '%s\n' "Tailcat forward failed to listen; see $log_file" >&2
  rm -f "$pid_file"
  return 1
}

stop_connection() {
  if ! running_pid; then
    rm -f "$pid_file"
    echo "Tailcat forward '$connection_name' is stopped."
    return
  fi
  local pid
  pid="$(<"$pid_file")"
  kill "$pid"
  for _ in $(seq 1 5); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  if kill -0 "$pid" 2>/dev/null; then
    # A stale Tailcat forward can remain alive without its listener after
    # SIGTERM. It cannot serve traffic, so force it down before a restart.
    kill -KILL "$pid"
    sleep 1
  fi
  kill -0 "$pid" 2>/dev/null && die "Tailcat forward PID $pid did not stop."
  rm -f "$pid_file"
  echo "Tailcat forward '$connection_name' stopped."
}

status_connection() {
  if running_pid; then
    echo "status: running (PID $(<"$pid_file"))"
  else
    rm -f "$pid_file"
    echo "status: stopped"
  fi
  list_connection
  if [[ -n "$TUNNEL_URL" ]]; then
    echo "Tunnel session:"
    echo "  public URL: $TUNNEL_URL"
    echo "  server endpoint: 127.0.0.1:$TUNNEL_PORT"
    echo "  note: Cloudflare Quick Tunnel URL changes if its service restarts."
  fi
}

list_connection() {
  echo "connection: $connection_name ($SERVER_USER@$SERVER_HOST)"
  echo "port mappings (local -> remote):"
  local mapping
  for mapping in "${port_mappings[@]}"; do
    echo "  127.0.0.1:${mapping%%:*} -> 127.0.0.1:${mapping##*:}"
  done
}

save_connection() {
  cat > "$config_file" <<CONFIG
TAILCAT_BIN='$TAILCAT_BIN'
TAILCAT_ADDRESS='$TAILCAT_ADDRESS'
SERVER_HOST='$SERVER_HOST'
SERVER_USER='$SERVER_USER'
SERVER_SSH_PORT='$SERVER_SSH_PORT'
SERVER_PORT='${port_mappings[0]##*:}'
CLIENT_PORT='${port_mappings[0]%%:*}'
PORT_MAPPINGS='$PORT_MAPPINGS'
TUNNEL_PORT='$TUNNEL_PORT'
TUNNEL_URL='$TUNNEL_URL'
CONFIG
  chmod 600 "$config_file"
}

update_server_ports() {
  local ports="$1" service_name="tailcat-$connection_name" key_name="tailcat-$connection_name"
  [[ "$SERVER_USER" =~ ^[A-Za-z0-9._-]+$ ]] || die "Invalid saved SSH user."
  local own_password=''
  if [[ -z "${SSHPASS:-}" ]]; then
    read -r -s -p "Server SSH password for $SERVER_USER@$SERVER_HOST: " server_password
    printf '\n'
    export SSHPASS="$server_password"
    own_password=1
  fi
  sshpass -e ssh -p "$SERVER_SSH_PORT" -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
    "$SERVER_USER@$SERVER_HOST" "sudo -n sed -i -E 's|^Description=.*|Description=Tailcat TCP forward for localhost ports: $ports|; s|^ExecStart=.*|ExecStart=/usr/local/bin/tailcat serve --key=$key_name $ports|' /etc/systemd/system/$service_name.service && sudo -n systemctl daemon-reload && sudo -n systemctl restart $service_name.service && sudo -n systemctl is-active --quiet $service_name.service" \
    || die "Could not update the remote Tailcat service."
  if [[ -n "$own_password" ]]; then unset SSHPASS server_password; fi
}

check_add_ports() {
  local remote_port="$1" local_port="$2"
  echo "확인 중: 로컬 포트 $local_port 사용 상태..."
  if ss -ltn "sport = :$local_port" 2>/dev/null | grep -q ":$local_port"; then
    die "Local port $local_port is already in use."
  fi
  echo "확인 중: 원격 내부 포트 $remote_port 리스너 상태..."
  sshpass -e ssh -p "$SERVER_SSH_PORT" -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
    "$SERVER_USER@$SERVER_HOST" "ss -ltn 'sport = :$remote_port' | grep -q ':$remote_port'" \
    || die "Remote internal port $remote_port is not listening."
  echo "확인 완료: 로컬 포트는 비어 있고 원격 내부 포트는 리스닝 중입니다."
}

add_mapping() {
  [[ $# -eq 2 ]] || die "Usage: tailcat add <remote-port> <local-port>"
  local remote_port="$1" local_port="$2" mapping
  valid_port "$remote_port" && valid_port "$local_port" || die "Ports must be between 1 and 65535."
  for mapping in "${port_mappings[@]}"; do
    [[ "${mapping%%:*}" != "$local_port" ]] || die "Local port $local_port is already mapped."
    [[ "${mapping##*:}" != "$remote_port" ]] || die "Remote port $remote_port is already mapped."
  done
  read -r -s -p "Server SSH password for $SERVER_USER@$SERVER_HOST: " server_password
  printf '\n'
  export SSHPASS="$server_password"
  check_add_ports "$remote_port" "$local_port"
  port_mappings+=("$local_port:$remote_port")
  local ports
  ports="$(printf '%s\n' "${port_mappings[@]##*:}" | sort -nu | paste -sd, -)"
  update_server_ports "$ports"
  PORT_MAPPINGS="$(IFS=,; echo "${port_mappings[*]}")"
  save_connection
  unset SSHPASS server_password
  echo "Added: 127.0.0.1:$local_port -> 127.0.0.1:$remote_port"
}

del_mapping() {
  [[ $# -eq 1 ]] || die "Usage: tailcat del <local-port>"
  local local_port="$1" mapping found='' updated=()
  valid_port "$local_port" || die "Port must be between 1 and 65535."
  for mapping in "${port_mappings[@]}"; do
    if [[ "${mapping%%:*}" == "$local_port" ]]; then found="$mapping"; else updated+=("$mapping"); fi
  done
  [[ -n "$found" ]] || die "No mapping uses local port $local_port."
  (( ${#updated[@]} > 0 )) || die "Refusing to remove the final mapping; use tailcat setup to replace it."
  port_mappings=("${updated[@]}")
  local ports
  ports="$(printf '%s\n' "${port_mappings[@]##*:}" | sort -nu | paste -sd, -)"
  update_server_ports "$ports"
  PORT_MAPPINGS="$(IFS=,; echo "${port_mappings[*]}")"
  save_connection
  echo "Removed: 127.0.0.1:${found%%:*} -> 127.0.0.1:${found##*:}"
}

reset_connection() {
  local service_name="tailcat-$connection_name" key_name="tailcat-$connection_name"
  local launcher_file="$CLIENT_BIN_DIR/tailcat-connect-$connection_name"
  echo "초기화 대상 확인:"
  echo "  로컬 포워더: $connection_name"
  echo "  로컬 설정: $config_file"
  echo "  원격 서비스: $SERVER_USER@$SERVER_HOST:$service_name.service"
  echo "  원격 저장 키: ~/.config/tailcat/keys/$key_name.private.json"
  echo "  유지 항목: $CLIENT_TAILCAT_BIN 및 tailcat 명령"
  local confirmation
  read -r -p "계속하려면 'RESET $connection_name' 입력: " confirmation
  if [[ "$confirmation" != "RESET $connection_name" ]]; then
    echo "초기화를 취소했습니다."
    return
  fi
  read -r -s -p "Server SSH password for $SERVER_USER@$SERVER_HOST: " server_password
  printf '\n'
  export SSHPASS="$server_password"
  echo "확인 중: 원격 Tailcat 서비스 접근 상태..."
  sshpass -e ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
    "$SERVER_USER@$SERVER_HOST" "sudo -n test -f /etc/systemd/system/$service_name.service" \
    || die "Remote Tailcat service was not found or sudo access failed."
  echo "중지 및 비활성화 중: 원격 Tailcat 서비스..."
  sshpass -e ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
    "$SERVER_USER@$SERVER_HOST" "sudo -n systemctl disable --now $service_name.service && sudo -n rm -f /etc/systemd/system/$service_name.service /run/$service_name/address && sudo -n -u $SERVER_USER rm -f /home/$SERVER_USER/.config/tailcat/keys/$key_name.private.json && sudo -n systemctl daemon-reload" \
    || die "Could not remove the remote Tailcat service. Local configuration was retained."
  unset SSHPASS server_password
  echo "중지 중: 로컬 Tailcat 포워더..."
  stop_connection
  echo "삭제 중: 로컬 연결 설정, 런처, 상태 파일..."
  rm -f "$config_file" "$launcher_file" "$pid_file" "$log_file"
  echo "정리 완료: $connection_name 연결 설정이 초기화되었습니다."
}

tunnel_connection() {
  local remote_port="${1:-3000}"
  local service_name="tailcat-tunnel-$connection_name-$remote_port"
  valid_port "$remote_port" || die "Tunnel port must be between 1 and 65535."
  read -r -s -p "Server SSH password for $SERVER_USER@$SERVER_HOST: " server_password
  printf '\n'
  export SSHPASS="$server_password"
  echo "확인 중: 원격 내부 포트 $remote_port 리스너 상태..."
  sshpass -e ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
    "$SERVER_USER@$SERVER_HOST" "ss -ltn 'sport = :$remote_port' | grep -q ':$remote_port'" \
    || die "Remote internal port $remote_port is not listening."
  echo "확인 중: 서버 cloudflared 설치 상태..."
  remote_output="$({ sshpass -e ssh -p "$SERVER_SSH_PORT" -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
    "$SERVER_USER@$SERVER_HOST" "sudo -n bash -s -- '$SERVER_USER' '$remote_port' '$service_name'" <<'REMOTE'
set -euo pipefail
server_user="$1"
remote_port="$2"
service_name="$3"
if ! command -v cloudflared >/dev/null 2>&1; then
  echo '설치 중: cloudflared...'
  arch="$(dpkg --print-architecture)"
  case "$arch" in amd64) package_arch=amd64 ;; arm64) package_arch=arm64 ;; *) exit 1 ;; esac
  work_dir="$(mktemp -d)"
  trap 'rm -rf "$work_dir"' EXIT
  curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-$package_arch.deb" -o "$work_dir/cloudflared.deb"
  dpkg -i "$work_dir/cloudflared.deb" >/dev/null
fi
cat > "/etc/systemd/system/$service_name.service" <<UNIT
[Unit]
Description=Cloudflare Quick Tunnel for localhost:$remote_port
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=$server_user
Environment=HOME=/home/$server_user
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:$remote_port
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now "$service_name.service"
for _ in $(seq 1 20); do
  url="$(journalctl -u "$service_name.service" --no-pager -n 50 | grep -Eo 'https://[-a-z0-9]+\.trycloudflare\.com' | tail -n 1 || true)"
  [ -n "$url" ] && { printf '__TUNNEL_URL__=%s\n' "$url"; exit 0; }
  sleep 1
done
exit 1
REMOTE
  } 2>&1)" || { unset SSHPASS server_password; printf '%s\n' "$remote_output" >&2; die "Could not create the Quick Tunnel."; }
  unset SSHPASS server_password
  TUNNEL_PORT="$remote_port"
  TUNNEL_URL="$(printf '%s\n' "$remote_output" | sed -n 's/^__TUNNEL_URL__=//p' | tail -n 1)"
  [[ "$TUNNEL_URL" =~ ^https://[-a-z0-9]+\.trycloudflare\.com$ ]] || die "Quick Tunnel did not return a public URL."
  PORT_MAPPINGS="$(IFS=,; echo "${port_mappings[*]}")"
  save_connection
  echo "Tunnel session started: $TUNNEL_URL"
}

install_prerequisites() {
  local packages=(bash openssh-client sshpass curl jq unzip iproute2 ca-certificates tar)
  local missing=()
  local package command
  declare -A package_commands=(
    [bash]=bash [openssh-client]=ssh [sshpass]=sshpass [curl]=curl
    [jq]=jq [unzip]=unzip [iproute2]=ss [tar]=tar
  )
  for package in "${packages[@]}"; do
    command="${package_commands[$package]:-}"
    if [[ -n "$command" ]]; then
      command -v "$command" >/dev/null 2>&1 || missing+=("$package")
    elif ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
      missing+=("$package")
    fi
  done
  if (( ${#missing[@]} == 0 )); then
    echo "확인 완료: 필요한 클라이언트 패키지가 모두 설치되어 있습니다."
    return
  fi
  command -v sudo >/dev/null 2>&1 || die "필수 패키지 설치에 sudo가 필요합니다: ${missing[*]}"
  echo "설치 중: 누락된 클라이언트 패키지: ${missing[*]}"
  sudo apt-get update
  sudo apt-get install -y "${missing[@]}"
  for package in "${missing[@]}"; do
    command -v "$package" >/dev/null 2>&1 || die "패키지 설치 후에도 명령을 찾을 수 없습니다: $package"
  done
  echo "설치 완료: 클라이언트 패키지"
}

install_self() {
  install_prerequisites
  echo "설치 중: ~/.local/bin 디렉터리 확인..."
  install -d -m 755 "$CLIENT_BIN_DIR"
  if [[ "$SCRIPT_PATH" != "$CLIENT_BIN_DIR/tailcat" ]]; then
    echo "설치 중: $SCRIPT_PATH -> $CLIENT_BIN_DIR/tailcat"
    install -m 755 "$SCRIPT_PATH" "$CLIENT_BIN_DIR/tailcat"
  else
    echo "확인 완료: 이미 ~/.local/bin/tailcat에서 실행 중입니다."
  fi
  echo '현재 셸에서 PATH를 적용하려면 다음을 실행하세요:'
  echo 'export PATH="$HOME/.local/bin:$PATH"'
  echo "설치 완료: $CLIENT_BIN_DIR/tailcat"
}

uninstall_self() {
  echo "확인 중: 설치된 실행 파일..."
  if [[ -e "$CLIENT_BIN_DIR/tailcat" || -L "$CLIENT_BIN_DIR/tailcat" ]]; then
    echo "삭제 중: $CLIENT_BIN_DIR/tailcat"
    rm -f "$CLIENT_BIN_DIR/tailcat"
    echo "언인스톨 완료: ~/.local/bin/tailcat를 제거했습니다."
  else
    echo "삭제할 ~/.local/bin/tailcat가 없습니다."
  fi
  echo '현재 셸의 PATH는 자동으로 바뀌지 않습니다. 필요하면 다음을 실행하세요:'
  echo 'export PATH="$HOME/.local/bin:$PATH"'
}

run_control_command() {
  local command="$1"
  shift
  case "$command" in
    start|stop|status|list|reset)
      load_connection "${1:-}"
      "$command"_connection
      ;;
    add|del)
      load_connection
      "${command}_mapping" "$@"
      ;;
    install|uninstall)
      "${command}_self"
      ;;
    tunnel)
      load_connection
      tunnel_connection "$@"
      ;;
  esac
}

case "${1:-}" in
  start|stop|status|list|add|del|reset|tunnel|install|uninstall)
    run_control_command "$@"
    exit 0
    ;;
  setup)
    shift
    ;;
  help|--help|-h)
    usage
    exit 0
    ;;
  '')
    usage
    exit 0
    ;;
  *)
    # Once installed on PATH, preserve the upstream Tailcat CLI for commands
    # other than this wrapper's setup/start/stop/status controls.
    if [[ "$0" == "$CLIENT_BIN_DIR/tailcat" && $# -gt 0 ]]; then
      [[ -x "$CLIENT_TAILCAT_BIN" ]] || die "Tailcat binary not found: $CLIENT_TAILCAT_BIN"
      exec "$CLIENT_TAILCAT_BIN" "$@"
    fi
    ;;
esac

install_client_dependencies() {
  if ! command -v sshpass >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1 || \
     ! command -v jq >/dev/null 2>&1 || ! command -v unzip >/dev/null 2>&1; then
    echo "Installing the client prerequisites (sshpass, curl, jq, unzip)..."
    sudo apt-get update
    sudo apt-get install -y sshpass curl jq unzip openssh-client
  fi
  require_command curl
  require_command jq
  require_command ssh
  require_command sshpass
  require_command unzip
}

install_tailcat_local() {
  if [[ -x "$CLIENT_TAILCAT_BIN" ]]; then
    printf '%s\n' "$CLIENT_TAILCAT_BIN"
    return
  fi

  # Migrate the previously installed upstream binary before installing this
  # wrapper at ~/.local/bin/tailcat.
  if [[ -x "$CLIENT_BIN_DIR/tailcat" && ! -L "$CLIENT_BIN_DIR/tailcat" ]]; then
    mv "$CLIENT_BIN_DIR/tailcat" "$CLIENT_TAILCAT_BIN"
    printf '%s\n' "$CLIENT_TAILCAT_BIN"
    return
  fi

  local architecture api_url download_url tmp_dir
  architecture="$(dpkg --print-architecture)"
  case "$architecture" in
    amd64) architecture="amd64" ;;
    arm64) architecture="arm64" ;;
    *) die "Unsupported client CPU architecture: $architecture" ;;
  esac

  api_url="https://api.github.com/repos/${TAILCAT_REPOSITORY}/releases/latest"
  download_url="$(curl -fsSL "$api_url" | jq -r --arg arch "$architecture" \
    '.assets[] | select(.name | test("linux_" + $arch + "\\.tar\\.gz$")) | .browser_download_url' | head -n 1)"
  [[ -n "$download_url" && "$download_url" != "null" ]] || die "Could not find a Tailcat Linux $architecture release."

  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' RETURN
  curl -fsSL "$download_url" -o "$tmp_dir/tailcat.tar.gz"
  tar -xzf "$tmp_dir/tailcat.tar.gz" -C "$tmp_dir"
  local binary
  binary="$(find "$tmp_dir" -type f -name tailcat -perm -u+x -print -quit)"
  [[ -n "$binary" ]] || die "The downloaded Tailcat archive did not contain an executable."
  install -d -m 700 "$CLIENT_BIN_DIR"
  install -m 755 "$binary" "$CLIENT_TAILCAT_BIN"
  printf '%s\n' "$CLIENT_TAILCAT_BIN"
}

install_command_wrapper() {
  install -d -m 700 "$CLIENT_BIN_DIR"
  ln -sfn "$SCRIPT_PATH" "$CLIENT_BIN_DIR/tailcat"
}

echo "Tailcat client-to-server setup (Ubuntu)"
read -r -p "Server VPN IP or hostname: " SERVER_HOST
read -r -p "Server SSH user: " SERVER_USER
read -r -s -p "Server SSH/sudo password: " SERVER_PASSWORD
printf '\n'
read -r -p "Server service port to expose (for example 22 or 8080): " SERVER_PORT
read -r -p "Client local port (must differ from the server port): " CLIENT_PORT

[[ -n "$SERVER_HOST" ]] || die "Server hostname/IP is required."
[[ "$SERVER_USER" =~ ^[a-zA-Z0-9._-]+$ ]] || die "The SSH user contains unsupported characters."
valid_port "$SERVER_PORT" || die "Server port must be between 1 and 65535."
valid_port "$CLIENT_PORT" || die "Client port must be between 1 and 65535."
[[ "$SERVER_PORT" != "$CLIENT_PORT" ]] || die "Choose a client port different from the server port."

if ss -ltn "sport = :$CLIENT_PORT" 2>/dev/null | grep -q ":$CLIENT_PORT"; then
  die "Client port $CLIENT_PORT is already in use. Choose another port."
fi

install_client_dependencies
TAILCAT_BIN="$(install_tailcat_local)"
install_command_wrapper
install -d -m 700 "$HOME/.ssh"

safe_name="$(printf '%s' "$SERVER_HOST" | tr -cs 'a-zA-Z0-9' '-')"
safe_name="${safe_name#-}"
safe_name="${safe_name%-}"
[[ -n "$safe_name" ]] || safe_name="server"
KEY_NAME="tailcat-${safe_name}"
SERVICE_NAME="tailcat-${safe_name}"

echo "Installing Tailcat and a persistent systemd service on $SERVER_HOST..."
export SSHPASS="$SERVER_PASSWORD"
if sshpass -e ssh \
  -o StrictHostKeyChecking=accept-new \
  -o UserKnownHostsFile="$HOME/.ssh/known_hosts" \
  "$SERVER_USER@$SERVER_HOST" 'sudo -n true' >/dev/null 2>&1; then
  remote_sudo_command='sudo -n'
  remote_sudo_password=''
else
  remote_sudo_command="sudo -S -p ''"
  remote_sudo_password="$SERVER_PASSWORD"
fi
remote_output="$({ sshpass -e ssh \
  -o StrictHostKeyChecking=accept-new \
  -o UserKnownHostsFile="$HOME/.ssh/known_hosts" \
  "$SERVER_USER@$SERVER_HOST" "$remote_sudo_command bash -s -- '$SERVER_USER' '$SERVER_PORT' '$KEY_NAME' '$SERVICE_NAME' '$TAILCAT_REPOSITORY'" <<REMOTE_SCRIPT
${remote_sudo_password:+$remote_sudo_password}
set -euo pipefail
server_user="\$1"
server_port="\$2"
key_name="\$3"
service_name="\$4"
repository="\$5"

apt-get update
apt-get install -y curl jq tar

architecture="\$(dpkg --print-architecture)"
case "\$architecture" in
  amd64) architecture="amd64" ;;
  arm64) architecture="arm64" ;;
  *) echo "Unsupported server CPU architecture: \$architecture" >&2; exit 1 ;;
esac

api_url="https://api.github.com/repos/\${repository}/releases/latest"
download_url="\$(curl -fsSL "\$api_url" | jq -r --arg arch "\$architecture" '.assets[] | select(.name | test("linux_" + \$arch + "\\\\.tar\\\\.gz$")) | .browser_download_url' | head -n 1)"
test -n "\$download_url" && test "\$download_url" != "null"

work_dir="\$(mktemp -d)"
trap 'rm -rf "\$work_dir"' EXIT
curl -fsSL "\$download_url" -o "\$work_dir/tailcat.tar.gz"
tar -xzf "\$work_dir/tailcat.tar.gz" -C "\$work_dir"
binary="\$(find "\$work_dir" -type f -name tailcat -perm -u+x -print -quit)"
test -n "\$binary"
install -m 755 "\$binary" /usr/local/bin/tailcat

# A saved key keeps the same Tailcat address after a reboot. If this is a
# re-run, genkey can report that the key already exists; Tailcat writes the
# current address to TAILCAT_ADDR_FILE when the service starts.
sudo -u "\$server_user" -H /usr/local/bin/tailcat genkey --key="\$key_name" >/dev/null 2>&1 || true

cat > "/etc/systemd/system/\$service_name.service" <<UNIT
[Unit]
Description=Tailcat TCP forward for localhost:\$server_port
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=\$server_user
Environment=HOME=/home/\$server_user
Environment=TAILCAT_ADDR_FILE=/run/\$service_name/address
RuntimeDirectory=\$service_name
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/tailcat serve --key=\$key_name \$server_port
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable "\$service_name.service"
systemctl restart "\$service_name.service"
systemctl is-active --quiet "\$service_name.service"
tailcat_address=""
for _ in \$(seq 1 10); do
  if [ -s "/run/\$service_name/address" ]; then
    tailcat_address="\$(cat "/run/\$service_name/address")"
    break
  fi
  sleep 1
done
if [ -z "\$tailcat_address" ]; then
  systemctl --no-pager --full status "\$service_name.service" >&2 || true
  echo "Could not read the Tailcat address from the address file." >&2
  exit 1
fi
printf '__TAILCAT_ADDRESS__=%s\n' "\$tailcat_address"
REMOTE_SCRIPT
} 2>&1)" || {
  unset SSHPASS SERVER_PASSWORD
  printf '%s\n' "$remote_output" >&2
  die "Server setup failed. Check SSH reachability, the password, and sudo access."
}
unset SSHPASS SERVER_PASSWORD

TAILCAT_ADDRESS="$(printf '%s\n' "$remote_output" | sed -n 's/^__TAILCAT_ADDRESS__=//p' | tail -n 1)"
[[ "$TAILCAT_ADDRESS" =~ ^tc[A-Za-z0-9_-]+$ ]] || {
  printf '%s\n' "$remote_output" >&2
  die "The server did not return a valid Tailcat address."
}

install -d -m 700 "$CLIENT_CONFIG_DIR" "$CLIENT_BIN_DIR"
config_file="$CLIENT_CONFIG_DIR/${safe_name}.env"
launcher_file="$CLIENT_BIN_DIR/tailcat-connect-${safe_name}"

cat > "$config_file" <<CONFIG
TAILCAT_BIN='$TAILCAT_BIN'
TAILCAT_ADDRESS='$TAILCAT_ADDRESS'
SERVER_HOST='$SERVER_HOST'
SERVER_USER='$SERVER_USER'
SERVER_PORT='$SERVER_PORT'
CLIENT_PORT='$CLIENT_PORT'
PORT_MAPPINGS='$CLIENT_PORT:$SERVER_PORT'
CONFIG
chmod 600 "$config_file"

cat > "$launcher_file" <<LAUNCHER
#!/usr/bin/env bash
set -euo pipefail
source '$config_file'
IFS=',' read -r -a port_mappings <<< "\${PORT_MAPPINGS:-\$CLIENT_PORT:\$SERVER_PORT}"
[[ "\$TAILCAT_BIN" == '$CLIENT_BIN_DIR/tailcat' ]] && TAILCAT_BIN='$CLIENT_TAILCAT_BIN'
exec "\$TAILCAT_BIN" forward "\$TAILCAT_ADDRESS" "\${port_mappings[@]}"
LAUNCHER
chmod 700 "$launcher_file"

cat <<RESULT

Setup complete.

Server service: $SERVICE_NAME.service
Client local endpoint: 127.0.0.1:$CLIENT_PORT
Forwarded server endpoint: 127.0.0.1:$SERVER_PORT

Start the client tunnel whenever needed:
  $launcher_file

Press Ctrl+C in that terminal to stop the client tunnel.
RESULT
